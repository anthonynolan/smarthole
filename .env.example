# Copy to .env and fill in. Never commit real values.
ENV=dev
MONGO_DB_NAME=smarthole_dev
MONGO_PWD=your-atlas-password-here
# Google OAuth client ID (same client as grimoire; add http://localhost:8123
# to its authorized origins in the Google Cloud console for local sign-in).
GOOGLE_CLIENT_ID=xxx
# Secret signing MCP OAuth access JWTs (generate once, e.g. `openssl rand -hex 32`).
# Required for /mcp + ChatGPT; same server .env key the deploy ships.
SECRET_KEY=change-me-to-a-long-random-secret
# Muse Spark (OpenAI-compatible) for AI card review.
MODEL_API_KEY=
# Optional overrides; defaults are the Meta endpoint + contributor model.
#AI_BASE_URL=https://api.meta.ai/v1
#AI_MODEL=muse-spark-1.3-contributor
# MCP (Streamable HTTP at /mcp) for ChatGPT connectors / Inspector.
MCP_ENABLED=1
MCP_RESOURCE_URL=http://localhost:8123/mcp
MCP_ISSUER_URL=http://localhost:8123
MCP_PUBLIC_BASE_URL=http://localhost:8123
# Prod uses https://smarthole.cathalanddad.com for all three URLs.
